---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { DEFAULT_THEME, THEME_NAMES, THEME_STORAGE_KEY } from '../config/themes';
import { getLanguageLinks, getLocaleFromPathname, toBcp47 } from '../utils/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AuroraCore',
  description = 'The intent-first operating system for AI agents',
} = Astro.props;

const pathname = Astro.url.pathname;
const currentLang = getLocaleFromPathname(pathname);
const languageLinks = getLanguageLinks(pathname);
const site = Astro.site ?? new URL('https://auroracore.dev');
const canonicalUrl = new URL(pathname, site).toString();
const xDefaultUrl = new URL('/en/', site).toString();
---

<!doctype html>
<html lang={toBcp47(currentLang)} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#070f1d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hrefLang="en" href={new URL(languageLinks.en, site).toString()} />
    <link rel="alternate" hrefLang="ru" href={new URL(languageLinks.ru, site).toString()} />
    <link rel="alternate" hrefLang="zh-CN" href={new URL(languageLinks.cn, site).toString()} />
    <link rel="alternate" hrefLang="ja-JP" href={new URL(languageLinks.jp, site).toString()} />
    <link rel="alternate" hrefLang="x-default" href={xDefaultUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AuroraCore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={toBcp47(currentLang)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href="/fonts/exo2-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/exo2-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script
      is:inline
      define:vars={{ defaultTheme: DEFAULT_THEME, storageKey: THEME_STORAGE_KEY, themeNames: THEME_NAMES }}
    >
      (() => {
        const root = document.documentElement;
        const availableThemes = new Set(themeNames);
        let theme = defaultTheme;

        try {
          const storedTheme = localStorage.getItem(storageKey);
          if (storedTheme && availableThemes.has(storedTheme)) {
            theme = storedTheme;
          }
        } catch {
          // Ignore storage failures.
        }

        root.setAttribute('data-theme', theme);
        root.style.colorScheme = 'dark';
      })();
    </script>
    <script is:inline>
      (() => {
        const startDate = Date.UTC(2026, 0, 29);
        const msPerDay = 1000 * 60 * 60 * 24;
        const day = Math.max(1, Math.floor((Date.now() - startDate) / msPerDay) + 1);

        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('[data-uptime-day]').forEach((node) => {
            node.textContent = String(day);
          });
        });
      })();
    </script>
  </head>
  <body>
    <div class="site-fog" aria-hidden="true"></div>
    <div class="site-noise" aria-hidden="true"></div>
    <div class="page-shell fade-in-up">
      <Header homeHref={`/${currentLang}/`} />
      <main class="main-shell">
        <slot />
      </main>
      <Footer currentLang={currentLang} languageLinks={languageLinks} />
    </div>
  </body>
</html>
