---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'AuroraCore — The intent-first OS for AI agents',
  description = 'R&D project building an operating system designed natively for AI agents. Intent-first architecture where agents efficiently execute tasks, communicate, and manage resources.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="AuroraCore Devlog" href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>
