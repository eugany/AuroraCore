---
import { DEFAULT_THEME, THEMES, THEME_STORAGE_KEY } from '../config/themes';
---

<div class="theme-switch" data-theme-switch>
  {THEMES.map((theme) => (
    <button
      type="button"
      class="theme-switch-btn"
      data-theme-value={theme.name}
      aria-label={`Switch to ${theme.label} theme`}
      title={theme.hint}
    >
      {theme.label}
    </button>
  ))}
</div>

<script
  is:inline
  define:vars={{ defaultTheme: DEFAULT_THEME, storageKey: THEME_STORAGE_KEY }}
>
  (() => {
    const root = document.documentElement;
    const switchers = document.querySelectorAll('[data-theme-switch]');

    const readTheme = () => root.getAttribute('data-theme') || defaultTheme;

    const markActive = (theme) => {
      switchers.forEach((switcher) => {
        switcher.querySelectorAll('[data-theme-value]').forEach((button) => {
          const isActive = button.getAttribute('data-theme-value') === theme;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      });
    };

    const applyTheme = (theme) => {
      root.setAttribute('data-theme', theme);
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        // Ignore storage failures.
      }
      window.dispatchEvent(new CustomEvent('aurora-theme-change', { detail: { theme } }));
      markActive(theme);
    };

    switchers.forEach((switcher) => {
      switcher.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) {
          return;
        }

        const button = target.closest('[data-theme-value]');
        if (!(button instanceof HTMLElement)) {
          return;
        }

        const nextTheme = button.getAttribute('data-theme-value');
        if (nextTheme) {
          applyTheme(nextTheme);
        }
      });
    });

    markActive(readTheme());
    window.addEventListener('aurora-theme-change', () => markActive(readTheme()));
  })();
</script>
