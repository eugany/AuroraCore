  <div class="nav-column">
    <h2 class="nav-title">KERNEL SPACE</h2>
    <a href={`/${lang}/devlog/`} class="nav-link">./devlog</a>
    <a href="/kernel/playbook" class="nav-link">./playbook</a>
    <a href="/kernel/specs" class="nav-link">./specs</a>
  </div>
  <div class="nav-column">
    <h2 class="nav-title">USER SPACE</h2>
    <a href="/vision/manifesto" class="nav-link">./manifesto</a>
    <a href="/vision/aurora-for-people" class="nav-link">./aurora-for-people</a>
    <a href="/landscape/" class="nav-link">./landscape</a>
    <a href="/library/" class="nav-link">./library</a>
    <a href="/about/" class="nav-link">./about</a>
  </div>
  <div class="nav-column">
    <h2 class="nav-title">AGENTS SPACE</h2>
    <a href="/agents/" class="nav-link">./index</a>
    <a href="/api/agent.json" class="nav-link">./api/agent.json</a>
    <a href="/agent.md" class="nav-link">./agent.md</a>
    <a href="/.well-known/llm.txt" class="nav-link">./llm.txt</a>
