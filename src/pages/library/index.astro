---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="AuroraCore - Library" description="Articles and media library">
  <section class="glass-card space-y-4 fade-in-up" style="animation-delay: 180ms;">
    <h1 class="text-3xl font-semibold text-[var(--color-heading)]">LIBRARY</h1>
    <p>
      Curated long-form materials: research notes, media, implementation essays, and references.
    </p>
    <p class="nav-muted">Initial index seeded. Media expansion is planned.</p>
  </section>
</BaseLayout>
