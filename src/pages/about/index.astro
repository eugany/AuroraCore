---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="AuroraCore - About" description="Project and team overview">
  <section class="space-y-4 fade-in-up" style="animation-delay: 180ms;">
    <article class="glass-card space-y-4">
      <h1 class="text-3xl font-semibold text-[var(--color-heading)]">ABOUT</h1>
      <p>
        AuroraCore is an active R&D initiative focused on intent-first operating systems for AI agents.
      </p>
      <p>
        Team: Core research collective (public roster to be expanded).
      </p>
    </article>

    <article class="glass-card space-y-3">
      <h2 class="text-xl text-[var(--color-heading)]">Press Kit</h2>
      <ul class="mission-list">
        <li>Brand: AuroraCore</li>
        <li>Tagline: The intent-first operating system for AI agents</li>
        <li>Site: <a href="https://auroracore.dev">auroracore.dev</a></li>
        <li>GitHub: <a href="https://github.com/AuroraCore">github.com/AuroraCore</a></li>
        <li>X: <a href="https://x.com/AuroraCore">x.com/AuroraCore</a></li>
        <li>Telegram: <a href="https://t.me/AuroraCore">t.me/AuroraCore</a></li>
      </ul>
    </article>
  </section>
</BaseLayout>
